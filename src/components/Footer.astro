---
import { type Locale, site } from '../content/site';
import { settings } from '../data/settings';
interface Props { lang: Locale }
const { lang } = Astro.props;
const c = site[lang];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-logo">
          <img src="/nest-icon.png" alt="" width="34" height="34" />
          <span class="wordmark"><span class="wm-nest">Nest</span><span class="wm-minds">Minds</span></span>
        </div>
        <p>{c.footer.tagline}</p>
      </div>
      <div>
        <h4>{c.footer.colA}</h4>
        <ul class="footer-links">{c.footer.linksA.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </div>
      <div>
        <h4>{c.footer.colB}</h4>
        <ul class="footer-links">{c.footer.linksB.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {settings.legalEntity}</span>
      <span>{c.footer.legal}</span>
    </div>
  </div>
</footer>
