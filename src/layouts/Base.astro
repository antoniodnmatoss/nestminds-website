---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Locale, htmlLang, site } from '../content/site';

interface Props { lang: Locale; title?: string; description?: string; altLocales?: Partial<Record<Locale, string>> }
const { lang, altLocales } = Astro.props;
const c = site[lang];
const title = Astro.props.title ?? c.meta.title;
const description = Astro.props.description ?? c.meta.description;
const skip = lang === 'en' ? 'Skip to content' : lang === 'es' ? 'Saltar al contenido' : 'Saltar para o conteúdo';
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <BaseHead lang={lang} title={title} description={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">{skip}</a>
    <Header lang={lang} altLocales={altLocales} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
